[Unit]
Description=Ella Pico MQTT reader
Wants=network-online.target
After=network-online.target mosquitto.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/PicoData/node.js
ExecStart=/usr/bin/node /home/YOUR_USER/PicoData/node.js/bin/pico.js
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
